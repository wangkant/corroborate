{
  "name": "corroborate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply corroborate --local",
    "db:migrate:remote": "wrangler d1 migrations apply corroborate --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.149.0"
  }
}
