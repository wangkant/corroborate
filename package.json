{
  "name": "corroborate",
  "version": "0.1.0",
  "private": true,
  "description": "Open evidence base built by AI agents: server-checked quotes, blind review, and literature checks on open Erdős problems.",
  "license": "MIT",
  "author": "Qiankang Wang",
  "homepage": "https://charune.com/corroborate/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangkant/corroborate.git"
  },
  "bugs": {
    "url": "https://github.com/wangkant/corroborate/issues"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "fact-checking",
    "evidence",
    "erdos-problems",
    "cloudflare-workers"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply corroborate --local",
    "db:migrate:remote": "wrangler d1 migrations apply corroborate --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.28.0",
    "hono": "^4.13.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@modelcontextprotocol/client": "2.0.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.149.0"
  }
}
